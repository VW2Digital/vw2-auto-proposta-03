# ==============================================================================
# NEXO STUDIO CMS (LARAVEL + FILAMENT) — PRODUÇÃO HOSTINGER (MYSQL / PHPMYADMIN)
# ==============================================================================
# 1. Copie este arquivo para `cms-laravel/.env` no servidor da Hostinger.
# 2. Preencha todos os campos marcados com << ... >> usando os dados do hPanel.
# 3. Gere a APP_KEY com: php artisan key:generate
# 4. Nunca suba o arquivo `.env` real para o Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APLICAÇÃO (PRODUÇÃO)
# ------------------------------------------------------------------------------
APP_NAME="Nexo Studio CMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# URL pública onde o CMS Laravel ficará hospedado (com https:// e sem barra final)
# Usada nas URLs das imagens da API e nos assets do painel /admin
APP_URL=https://cms.seudominio.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS MYSQL — HOSTINGER (hPanel -> Bancos de Dados -> phpMyAdmin)
# ------------------------------------------------------------------------------
# Driver MySQL (compatível com MySQL/MariaDB da Hostinger)
DB_CONNECTION=mysql

# Host do banco:
# - Se o Laravel roda na PRÓPRIA hospedagem Hostinger: use `127.0.0.1` ou `localhost`
# - Se conectar de fora (MySQL Remoto habilitado no hPanel): use o hostname do hPanel (ex.: srv1234.hstgr.io)
DB_HOST=127.0.0.1
DB_PORT=3306

# Copie exatamente do hPanel -> Bancos de Dados -> Gerenciamento / phpMyAdmin:
DB_DATABASE=<<u000000000_nome_do_banco>>
DB_USERNAME=<<u000000000_usuario_do_banco>>
DB_PASSWORD="<<SUA_SENHA_FORTE_DO_BANCO>>"

DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ------------------------------------------------------------------------------
# 3. SITE FRONTEND, CORS E FLUXO DE PROPOSTAS
# ------------------------------------------------------------------------------
# URL pública do site React (sem barra final)
FRONTEND_URL=https://seudominio.com.br

# Origens autorizadas a chamar /api/* (separe múltiplas por vírgula, sem barra final)
CORS_ALLOWED_ORIGINS=https://seudominio.com.br,https://www.seudominio.com.br

# Senha que o cliente digita para desbloquear o link /proposta/{token}
PROPOSAL_ACCESS_PASSWORD="<<TROQUE_SENHA_PROPOSTA>>"

# Fuso exibido no painel admin (o banco grava em UTC)
CMS_DISPLAY_TIMEZONE=America/Sao_Paulo

# ------------------------------------------------------------------------------
# 4. ADMIN INICIAL (usado em `php artisan db:seed --force`)
# ------------------------------------------------------------------------------
# Preencha antes do primeiro seed. Depois pode remover a senha deste arquivo se preferir.
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD="<<TROQUE_SENHA_ADMIN_FORTE>>"

# ------------------------------------------------------------------------------
# 5. SESSÃO, CACHE, FILAS E STORAGE (HOSPEDAGEM COMPARTILHADA HOSTINGER)
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ------------------------------------------------------------------------------
# 6. E-MAIL SMTP (HOSTINGER — hPanel -> E-mails -> Configurações)
# ------------------------------------------------------------------------------
# Necessário para recuperação de senha do painel /admin
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=contato@seudominio.com.br
MAIL_PASSWORD="<<SUA_SENHA_DE_EMAIL_HOSTINGER>>"
MAIL_FROM_ADDRESS="contato@seudominio.com.br"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
