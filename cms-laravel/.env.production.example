# ==============================================================================
# NEXO STUDIO (SITE + CMS + ADMIN) — PRODUÇÃO HOSTINGER (DOMÍNIO ÚNICO + MYSQL)
# ==============================================================================
# Arquitetura unificada (Opção 1):
#   - https://vw2digital.com.br/       -> Site React (servido via spa.html)
#   - https://vw2digital.com.br/admin  -> Painel Filament
#   - https://vw2digital.com.br/api/*  -> API JSON (mesma origem, sem CORS)
#
# Como usar na Hostinger:
#   1. Copie este arquivo para `domains/vw2digital.com.br/nexo-cms/.env`
#   2. Preencha todos os campos marcados com << ... >>
#   3. Gere a APP_KEY com: php artisan key:generate --force
#   4. Nunca suba o arquivo `.env` real para o Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APLICAÇÃO (DOMÍNIO ÚNICO EM PRODUÇÃO)
# ------------------------------------------------------------------------------
APP_NAME="Nexo Studio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# Domínio principal (com https:// e sem barra no final)
# Usado pelo site, painel /admin, preview, link da proposta e URLs de imagens.
APP_URL=https://vw2digital.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS MYSQL — HOSTINGER (hPanel -> Bancos de Dados -> phpMyAdmin)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql

# Na hospedagem compartilhada Hostinger (PHP e MySQL no mesmo servidor): use `127.0.0.1` ou `localhost`.
# Apenas para acesso externo (MySQL Remoto): use o host informado no hPanel (ex.: srv1234.hstgr.io).
DB_HOST=127.0.0.1
DB_PORT=3306

# Copie exatamente do hPanel -> Bancos de Dados -> Gerenciamento / phpMyAdmin:
DB_DATABASE=<<u000000000_nome_do_banco>>
DB_USERNAME=<<u000000000_usuario_do_banco>>
DB_PASSWORD="<<SUA_SENHA_FORTE_DO_BANCO>>"

DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ------------------------------------------------------------------------------
# 3. PROPOSTAS, PAINEL E CORS
# ------------------------------------------------------------------------------
# No modo domínio único, FRONTEND_URL herda APP_URL automaticamente se ficar igual ou vazio.
FRONTEND_URL="${APP_URL}"

# Mesmo domínio (e versão www se utilizada)
CORS_ALLOWED_ORIGINS=https://vw2digital.com.br,https://www.vw2digital.com.br

# Senha que o cliente digita para abrir /proposta/{token}
PROPOSAL_ACCESS_PASSWORD="<<TROQUE_SENHA_PROPOSTA>>"

# Fuso exibido no painel admin (banco grava em UTC)
CMS_DISPLAY_TIMEZONE=America/Sao_Paulo

# ------------------------------------------------------------------------------
# 4. ADMIN INICIAL (usado em `php artisan db:seed --force`)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@nexo.test
ADMIN_PASSWORD="<<TROQUE_SENHA_ADMIN_FORTE>>"

# ------------------------------------------------------------------------------
# 5. SESSÃO, CACHE E FILA (OTIMIZADO PARA HOSPEDAGEM COMPARTILHADA HOSTINGER)
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database

# `sync` executa imediatamente (hospedagem compartilhada não mantém queue:work rodando 24h)
QUEUE_CONNECTION=sync

# ------------------------------------------------------------------------------
# 6. E-MAIL SMTP (HOSTINGER — hPanel -> E-mails -> Configurações)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=contato@vw2digital.com.br
MAIL_PASSWORD="<<SUA_SENHA_DE_EMAIL_HOSTINGER>>"
MAIL_FROM_ADDRESS="contato@vw2digital.com.br"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
